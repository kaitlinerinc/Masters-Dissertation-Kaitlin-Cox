scot_charity_pattern <- "\\bSC[0-9]{5}\\b"
phone_pattern        <- "\\b0800\\s?[0-9\\s]{3,}\\s?[0-9\\s]{3,}|\\b020\\s?[0-9\\s]{4,}\\s?[0-9\\s]{4,}"
# Expanded boilerplate tracking based on common fundraising structures
gift_aid_boilerplate <- "(?i)gift\\s+aid\\s+donations?|free_post|freepost|\\bworksh[0-9a-zA-Z]+|gift\\s+aid\\s+declaration"
# High-intensity scanner trash (e.g., "869% 68. coe se ——<__ co")
ocr_trash_pattern    <- "[~`^|\\–—_<>#]+|[0-9]+%|\\b[0-9]{2,}\\.\\b|\\b(eee|vvv|xxx|coe|se|lele|eeses)\\s*\\b"
# 3. CONTEXTUAL SPELLING CORRECTION DICTIONARY
# Targets persistent OCR errors found in these specific donor appeal distributions
ocr_corrections <- c(
"\\bond\\b"   = "and",
"\\bmarcl\\b" = "march",
"\\bmums\\b"  = "mothers", # Optional normalization for semantic text mining
"\\bmum\\b"   = "mother"
)
# 4. ENHANCED STRUCTURAL NOISE ARRAY
more_boilerplate <- c(
"delivered by royal mail", "royal mail postage paid", "postage paid gb", "melksham[0-9]*",
"lower ground floor", "chancery exchange", "furnival street", "london ec[0-9a-z]*",
"printed on sustainable paper", "is recyclable", "crrecycle", "facebook\\.com/\\S+",
"twitter\\.com/\\S+", "photograph\\s+©\\s+[^|]+", "charity\\s+reg\\s+no\\.?\\s*[0-9]+",
"registration\\s+no\\.?\\s*[0-9]+", "company\\s+limited\\s+by\\s+guarantee",
"registered office as above", "united kingdom", "donor care", "privacy statement"
)
boilerplate_regex <- paste0("(?i)\\b(", paste(more_boilerplate, collapse = "|"), ")\\b")
# 5. CORE CLEANING ENGINE
clean_text_field <- function(text) {
if (is.na(text) || text == "") return(NA_character_)
# Standardize casing early to streamline structural regex checks
clean <- tolower(text)
# Strip away baseline pipeline formatting markers
clean <- str_replace_all(clean, "\\|", " ")
# Structural noise sweep
clean <- str_replace_all(clean, url_pattern, " ")
clean <- str_replace_all(clean, email_pattern, " ")
clean <- str_replace_all(clean, postcode_pattern, " ")
clean <- str_replace_all(clean, charity_num_pattern, " ")
clean <- str_replace_all(clean, scot_charity_pattern, " ")
clean <- str_replace_all(clean, phone_pattern, " ")
clean <- str_replace_all(clean, gift_aid_boilerplate, " ")
clean <- str_replace_all(clean, boilerplate_regex, " ")
clean <- str_replace_all(clean, ocr_trash_pattern, " ")
# Apply contextual corrections using named vector translation
clean <- str_replace_all(clean, ocr_corrections)
# Drop random stray numbers that carry no semantic value out of context
clean <- str_replace_all(clean, "\\b\\d+\\b", " ")
# Drop isolated single characters left behind by fractured strings (keeps "a", "i")
clean <- str_replace_all(clean, "\\b[^ai]\\b", " ")
# Collapse spaces down cleanly
clean <- str_squish(clean)
return(clean)
}
# 6. PROCESSING AND DEDUPLICATION PIPELINE
cleaned_df <- df %>%
# Use purrr::map_chr for type-safe execution over vector inputs
mutate(CleanedText = map_chr(ExtractedText, clean_text_field)) %>%
# Prevent downstream empty token assignment issues in quanteda
filter(!is.na(CleanedText) & nchar(CleanedText) > 10) %>%
# Deduplicate repeated identical single-page copies before aggregation
distinct(CleanedText, .keep_all = TRUE)
# 7. LOGICAL AGGREGATION INTO SINGLE AD UNITS
# Ensures both pagination letters ('01a') and rotation text modifiers are dropped
final_aggregated_corpus <- cleaned_df %>%
mutate(
Ad_Base_ID = FileName %>%
str_replace_all("(?i)-rotated", "") %>%       # Drops rotation tag
str_replace("^([0-9]+)[a-zA-Z]", "\\1") %>%  # Isolates the uniform document root index
str_trim()
) %>%
group_by(Ad_Base_ID) %>%
summarise(
# Collates the multi-page letters back into sequential layout strings
CombinedAdText = paste(CleanedText, collapse = " "),
PagesInAd      = n(),
# Safely handles line counts if present in your input metrics
TotalOriginalLines = if("OriginalLineCount" %in% names(.)) sum(OriginalLineCount, na.rm = TRUE) else NA,
.groups = 'drop'
) %>%
# Final sanity pass on aggregated values
filter(nchar(CombinedAdText) > 20)
# 8. EXPORT FOR QUANTEDA TOKENS / CORPUS GENERATION
write_xlsx(final_aggregated_corpus, "C:/Users/unity/Documents/Dissertation/Mailout_Final_Cleaned.xlsx")
saveRDS(final_aggregated_corpus, "C:/Users/unity/Documents/Dissertation/Mailout_Final_Cleaned.rds")
