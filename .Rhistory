library(writexl)
library(purrr)  # Added for safer, faster string mappings
# 1. LOAD YOUR RAW OCR DATA
df <- read_xlsx("C:/Users/unity/Documents/Dissertation/Mailout.xlsx")
# 2. DEFINE SYSTEMATIC CLEANING PATTERNS (REGEX)
