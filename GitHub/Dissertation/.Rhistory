# Process Word Frequency Visuals
process_word_freq(token_df, vuln_dict, "Vulnerability", PRIMARY_DIR)
process_word_freq(token_df, charity_donor_agency_dict, "Charity_Donor_Agency", PRIMARY_DIR)
# Marginal Effects (Clustered SEs by Charity)
extract_predictions <- function(model, outcome_name, df_data){
prediction_data <- data.frame(
Is_Global_South = c(0, 1), # Numeric indicator matching regression model
NoiseRatio = mean(df_data$NoiseRatio, na.rm = TRUE),
log_valid_words = mean(df_data$log_valid_words, na.rm = TRUE),
stringsAsFactors = FALSE
)
vcov_mat <- sandwich::vcovCL(model, cluster = df_data$Charity)
predictions(model, newdata = prediction_data, vcov = vcov_mat, type = "response") %>%
mutate(Outcome = outcome_name,
Region = factor(ifelse(Is_Global_South == 1, "Global South", "Global North"), levels = c("Global North", "Global South"))) %>%
dplyr::select(Outcome, Region, estimate, conf.low, conf.high)
}
marginal_table <- bind_rows(
extract_predictions(model_vuln_unique, "Vulnerability", results_df_unique),
extract_predictions(model_charity_unique, "Charity/Donor Agency", results_df_unique)
)
print(xtable(marginal_table),
file = file.path(PRIMARY_DIR, "Marginal_Effects_Table.tex"), include.rownames = FALSE, scalebox = 0.9)
plot_marginal_effects <- function(prediction_df, outcome_name){
prediction_df %>% filter(Outcome == outcome_name) %>%
ggplot(aes(x = Region, y = estimate)) +
geom_point(size = 4) +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high), width = .15, linewidth = .8) +
theme_classic(base_size = 14) +
labs(title = outcome_name, x = NULL, y = "Predicted keyword count")
}
combined_marginal_plot <- plot_marginal_effects(marginal_table, "Vulnerability") | plot_marginal_effects(marginal_table, "Charity/Donor Agency")
combined_marginal_plot <- combined_marginal_plot
ggsave(file.path(PRIMARY_DIR, "Combined_Marginal_Effects.pdf"), combined_marginal_plot, width = 12, height = 5, device = "pdf")
# ==============================================================================
# 7. APPENDIX SECTION OUTPUTS (Organized A through F)
# ==============================================================================
# --- Appendix A: Dictionary Development ---
dict_df_vuln <- data.frame(Terms = paste(vuln_dict, collapse = ", "))
print(xtable(dict_df_vuln, caption = "Vulnerability Dictionary"),
file = file.path(APPENDIX_DIR, "Table_A1_Vulnerability_Dictionary.tex"), include.rownames = FALSE)
dict_df_charity <- data.frame(Terms = paste(charity_donor_agency_dict, collapse = ", "))
print(xtable(dict_df_charity, caption = "Charity/Donor Agency Dictionary"),
file = file.path(APPENDIX_DIR, "Table_A2_Charity_Dictionary.tex"), include.rownames = FALSE)
# --- Appendix B: Word Frequency Tables ---
generate_freq_table <- function(token_data, dict, caption_text, filename) {
freq_df <- token_data %>% filter(word %in% dict) %>% count(word, sort = TRUE)
print(xtable(freq_df, caption = caption_text),
file = file.path(APPENDIX_DIR, filename), include.rownames = FALSE, scalebox = 0.9)
}
generate_freq_table(token_df, vuln_dict, "Vulnerability Word Frequencies", "Table_B1_Vuln_Freq.tex")
generate_freq_table(token_df, charity_donor_agency_dict, "Charity/Donor Agency Word Frequencies", "Table_B2_Charity_Freq.tex")
# --- Appendix C: Regional Word Breakdown ---
generate_region_breakdown <- function(token_data, dict, caption_text, filename){
breakdown_df <- token_data %>%
filter(word %in% dict) %>% count(word, Region, name = "Frequency") %>%
tidyr::pivot_wider(names_from = Region, values_from = Frequency, values_fill = list(Frequency = 0))
if(!"Global South" %in% names(breakdown_df)) breakdown_df$`Global South` <- 0
if(!"Global North" %in% names(breakdown_df)) breakdown_df$`Global North` <- 0
breakdown_df <- breakdown_df %>%
mutate(Total = `Global South` + `Global North`,
`South Proportion` = round(`Global South` / pmax(Total, 1), 3)) %>%
arrange(desc(Total)) %>%
dplyr::select(Word = word, `Global North`, `Global South`, `South Proportion`)
print(xtable(breakdown_df, caption = caption_text),
file = file.path(APPENDIX_DIR, filename), include.rownames = FALSE, scalebox = 0.85)
}
generate_region_breakdown(token_df, vuln_dict, "Vulnerability words by region", "Table_C1_Vuln_Region_Breakdown.tex")
generate_region_breakdown(token_df, charity_donor_agency_dict, "Charity/donor agency words by region", "Table_C2_Charity_Region_Breakdown.tex")
# --- Appendix D: Regression Robustness ---
irr_vuln <- extract_clustered_irr(model_vuln_unique, results_df_unique$Charity)
irr_charity <- extract_clustered_irr(model_charity_unique, results_df_unique$Charity)
combined_irr <- bind_rows(irr_vuln %>% mutate(Model = "Vulnerability"), irr_charity %>% mutate(Model = "Charity/Agency"))
print(xtable(combined_irr, caption = "Clustered IRRs and Confidence Intervals (Clustered by Charity)"),
file = file.path(APPENDIX_DIR, "Table_D1_Robust_IRRs.tex"), include.rownames = TRUE)
model_vuln_no_noise <- glm.nb(vuln_hits ~ Is_Global_South + offset(log_valid_words), data = results_df_unique)
model_charity_no_noise <- glm.nb(charity_donor_agency_hits ~ Is_Global_South + offset(log_valid_words), data = results_df_unique)
modelsummary(
list("Vuln (No Noise)" = model_vuln_no_noise, "Charity (No Noise)" = model_charity_no_noise),
vcov = ~ Charity, exponentiate = TRUE, coef_map = coef_map, statistic = "conf.int", stars = TRUE,
title = "Models excluding OCR Noise Ratio (SEs Clustered by Charity)",
output = file.path(APPENDIX_DIR, "Table_D2_Robustness_No_Noise.tex")
)
# --- Appendix E: Model Diagnostics ---
diag_df <- tibble(
Model = c("Vulnerability", "Charity/Donor Agency"),
AIC = c(AIC(model_vuln_unique), AIC(model_charity_unique)),
BIC = c(BIC(model_vuln_unique), BIC(model_charity_unique)),
LogLik = c(as.numeric(logLik(model_vuln_unique)), as.numeric(logLik(model_charity_unique))),
`McFadden R2` = c(pscl::pR2(model_vuln_unique)["McFadden"], pscl::pR2(model_charity_unique)["McFadden"])
)
print(xtable(diag_df, caption = "Model diagnostics"), file = file.path(APPENDIX_DIR, "Table_E1_Model_Diagnostics.tex"), include.rownames = FALSE)
disp_df <- tibble(Model = c("Vulnerability", "Charity/Donor Agency"), Theta = c(model_vuln_unique$theta, model_charity_unique$theta))
print(xtable(disp_df, caption = "Dispersion (theta)"), file = file.path(APPENDIX_DIR, "Table_E2_Dispersion_Theta.tex"), include.rownames = FALSE)
pearson_df <- tibble(
Model = c("Vulnerability", "Charity/Donor Agency"),
Pearson_Dispersion = c(sum(residuals(model_vuln_unique, type="pearson")^2)/df.residual(model_vuln_unique),
sum(residuals(model_charity_unique, type="pearson")^2)/df.residual(model_charity_unique))
)
print(xtable(pearson_df, caption="Pearson dispersion diagnostics"), file = file.path(APPENDIX_DIR, "Table_E3_Pearson_Diagnostics.tex"), include.rownames = FALSE)
pois_vuln <- glm(vuln_hits ~ Is_Global_South + NoiseRatio + offset(log_valid_words), family = poisson, data = results_df_unique)
pois_charity <- glm(charity_donor_agency_hits ~ Is_Global_South + NoiseRatio + offset(log_valid_words), family = poisson, data = results_df_unique)
print(xtable(broom::tidy(lmtest::lrtest(pois_vuln, model_vuln_unique)), caption = "LRT Vulnerability (Poisson vs NB)"), file = file.path(APPENDIX_DIR, "Table_E4_LRT_Vuln.tex"), include.rownames = FALSE)
print(xtable(broom::tidy(lmtest::lrtest(pois_charity, model_charity_unique)), caption = "LRT Charity/Donor Agency (Poisson vs NB)"), file = file.path(APPENDIX_DIR, "Table_E4_LRT_Charity.tex"), include.rownames = FALSE)
model_vuln_zi <- zeroinfl(vuln_hits ~ Is_Global_South + NoiseRatio + offset(log_valid_words), data = results_df_unique)
model_charity_zi <- zeroinfl(charity_donor_agency_hits ~ Is_Global_South + NoiseRatio + offset(log_valid_words), data = results_df_unique)
zi_aic <- tibble(
Model = c("Vuln (NB)", "Vuln (ZI)", "Charity (NB)", "Charity (ZI)"),
df = c(AIC(model_vuln_unique, model_vuln_zi)$df, AIC(model_charity_unique, model_charity_zi)$df),
AIC = c(AIC(model_vuln_unique, model_vuln_zi)$AIC, AIC(model_charity_unique, model_charity_zi)$AIC)
)
print(xtable(zi_aic, caption = "Zero-inflated vs. standard negative binomial AIC comparison"), file = file.path(APPENDIX_DIR, "Table_E5_Zero_Inflated_AIC.tex"), include.rownames = FALSE)
# --- Appendix F: Correlation and Collinearity ---
cor_matrix <- cor(results_df_unique %>% dplyr::select(vuln_hits, charity_donor_agency_hits), method = "spearman", use = "complete.obs")
colnames(cor_matrix) <- rownames(cor_matrix) <- c("Vulnerability", "Charity/Donor Agency")
print(xtable(cor_matrix, caption = "Spearman correlation matrix"), file = file.path(APPENDIX_DIR, "Table_F1_Spearman_Correlation.tex"), include.rownames = TRUE)
vif_vuln <- vif(lm(vuln_hits ~ Is_Global_South + NoiseRatio, data = results_df_unique))
vif_charity <- vif(lm(charity_donor_agency_hits ~ Is_Global_South + NoiseRatio, data = results_df_unique))
extract_vif_vector <- function(vif_res) {
if (is.matrix(vif_res) || is.data.frame(vif_res)) {
col_names <- colnames(vif_res)
if ("VIF" %in% col_names) {
vals <- vif_res[, "VIF"]
} else if ("GVIF^(1/(2*Df))" %in% col_names) {
vals <- vif_res[, "GVIF^(1/(2*Df))"]^2
} else {
vals <- vif_res[, 1]
}
names(vals) <- rownames(vif_res)
return(vals)
} else {
return(vif_res)
}
}
vif_v_vals <- extract_vif_vector(vif_vuln)
vif_c_vals <- extract_vif_vector(vif_charity)
vif_df <- data.frame(
Variable = names(vif_v_vals),
`Vulnerability VIF` = as.numeric(vif_v_vals),
`Charity/Agency VIF` = as.numeric(vif_c_vals),
check.names = FALSE
)
print(xtable(vif_df, caption = "Variance Inflation Factors (VIF)"), file = file.path(APPENDIX_DIR, "Table_F2_VIF.tex"), include.rownames = FALSE)
# ==============================================================================
# UPDATED: Stratified & Fully Randomized KWIC Helper Function (Foolproof)
# ==============================================================================
generate_stratified_kwic <- function(df_data, dict, window_words = 5, samples_per_word = 3) {
results_list <- map2(df_data$text, df_data$Ad_Base_ID, function(txt, id) {
words <- str_split(txt, "\\s+")[[1]]
if(length(words) == 0) return(NULL)
matches <- which(words %in% dict)
if(length(matches) == 0) return(NULL)
map_dfr(matches, function(idx) {
start_idx <- max(1, idx - window_words)
end_idx <- min(length(words), idx + window_words)
tibble(
Ad_ID = as.character(id),
Pre = paste(words[start_idx:(idx-1)], collapse = " "),
Keyword = words[idx],
Post = paste(words[(idx+1):end_idx], collapse = " ")
)
})
})
all_matches <- bind_rows(results_list)
if(nrow(all_matches) == 0) return(all_matches)
# Safely sample per group by splitting the data frame,
# avoiding dplyr data-masking evaluation errors on n
all_matches %>%
split(.$Keyword) %>%
map_dfr(~ .x %>% slice_sample(n = min(samples_per_word, nrow(.x)))) %>%
slice_sample(prop = 1.0) # Complete random shuffle of final table
}
# Run the randomized/stratified KWIC generation across unique ads
kwic_vuln_df <- generate_stratified_kwic(results_df_unique, vuln_dict, window_words = 5, samples_per_word = 2)
kwic_charity_df <- generate_stratified_kwic(results_df_unique, charity_donor_agency_dict, window_words = 5, samples_per_word = 1)
if(nrow(kwic_vuln_df) > 0) {
xt_kwic_v <- xtable(kwic_vuln_df, caption = "Randomized Key Word in Context (KWIC): Vulnerability Dictionary Validation")
align(xt_kwic_v) <- c("l", "p{2.5cm}", "p{5cm}", "p{2.2cm}", "p{5cm}")
print(xt_kwic_v, file = file.path(APPENDIX_DIR, "Table_F1_KWIC_Vulnerability.tex"), include.rownames = FALSE, scalebox = 0.70)
}
if(nrow(kwic_charity_df) > 0) {
xt_kwic_c <- xtable(kwic_charity_df, caption = "Randomized Key Word in Context (KWIC): Charity/Donor Agency Dictionary Validation")
align(xt_kwic_c) <- c("l", "p{2.5cm}", "p{5cm}", "p{2.2cm}", "p{5cm}")
print(xt_kwic_c, file = file.path(APPENDIX_DIR, "Table_F2_KWIC_Charity.tex"), include.rownames = FALSE, scalebox = 0.70)
}
################################################################################
# 1. Stratified KWIC Sampling Function
generate_stratified_kwic <- function(df, dict, window_words = 4, samples_per_word = 2) {
dict_lower <- unique(tolower(dict))
kwic_list <- list()
for (i in seq_len(nrow(df))) {
id <- df$Ad_Base_ID[i]
txt <- df$text[i]
# Clean and split into individual word tokens
words <- unlist(str_split(txt, "\\s+"))
words <- words[words != ""]
if (length(words) == 0) next
# Identify match positions for dictionary words
matches <- which(tolower(words) %in% dict_lower)
if (length(matches) > 0) {
for (m in matches) {
kw <- words[m]
start_idx <- max(1, m - window_words)
end_idx <- min(length(words), m + window_words)
pre <- if (start_idx < m) paste(words[start_idx:(m - 1)], collapse = " ") else ""
post <- if (end_idx > m) paste(words[(m + 1):end_idx], collapse = " ") else ""
kwic_list[[length(kwic_list) + 1]] <- tibble(
Ad_ID = id,
Pre = pre,
Keyword = kw,
Post = post
)
}
}
}
if (length(kwic_list) == 0) {
return(tibble(Ad_ID = character(), Pre = character(), Keyword = character(), Post = character()))
}
# Return stratified sample (top N instances per matched keyword)
bind_rows(kwic_list) %>%
group_by(Keyword) %>%
slice_head(n = samples_per_word) %>%
ungroup()
}
# 2. Function to format, truncate, and save as readable LaTeX table
save_academic_table <- function(df, filename, title, max_rows = 15) {
df %>%
# Truncate to top N hits to fit LaTeX page dimensions nicely
slice_head(n = max_rows) %>%
mutate(
# Format keyword in bold blue text
Keyword = cell_spec(Keyword, "latex", bold = TRUE, color = "blue")
) %>%
kable(
format = "latex",
booktabs = TRUE,
escape = FALSE,
caption = title,
col.names = c("Ad ID", "Pre-Context", "Keyword", "Post-Context")
) %>%
# Column widths force text-wrapping and clean alignment
column_spec(1, width = "1.2cm", latex_align = "c") %>% # Ad ID
column_spec(2, width = "5.5cm", latex_align = "r") %>% # Pre-Context (Right-aligned)
column_spec(3, width = "2.5cm", latex_align = "c") %>% # Keyword (Centered)
column_spec(4, width = "5.5cm", latex_align = "l") %>% # Post-Context (Left-aligned)
kable_styling(
latex_options = c("hold_position", "striped"),
font_size = 9
) %>%
writeLines(file.path(APPENDIX_DIR, filename))
}
# 3. Generate & Export Vulnerability KWIC
kwic_vuln_df <- generate_stratified_kwic(
results_df_unique,
vuln_dict,
window_words = 4,
samples_per_word = 2
)
save_academic_table(
kwic_vuln_df,
"Table_D1_Vulnerability_KWIC.tex",
"Construct Validation: Vulnerability Dictionary KWIC (Sample Hits)"
)
