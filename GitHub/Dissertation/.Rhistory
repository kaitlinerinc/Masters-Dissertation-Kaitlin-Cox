charity_summary_top20 <- charity_summary %>%
slice_max(order_by = Advertisement_Appearances, n = 20, with_ties = FALSE)
p_dumbbell <- ggplot(charity_summary_top20, aes(y = reorder(Charity, Advertisement_Appearances), color = Region)) +
# Draw line between the two points
geom_segment(
aes(x = Unique_Advertisements, xend = Advertisement_Appearances, yend = Charity),
linewidth = 0.8,
alpha = 0.7
) +
# Plot points for Unique Ads and Total Appearances
geom_point(aes(x = Unique_Advertisements, shape = "Unique Advertisements"), size = 3.5) +
geom_point(aes(x = Advertisement_Appearances, shape = "Total Appearances"), size = 3.5) +
# Scales and themes
scale_color_manual(name = "Region", values = c("Global North" = "#2c3e50", "Global South" = "#e74c3c")) +
# FIXED: Names now match the exact strings in aes(shape = ...) above
scale_shape_manual(
name = "Metric",
values = c("Unique Advertisements" = 16, "Total Appearances" = 17)
) +
labs(
title = "Advertisement Frequency: Unique Ads vs Total (Top 20)",
subtitle = "Dumbbell comparison of unique ads and total ad appearances by charity",
x = "Number of Advertisements",
y = NULL
) +
theme_classic(base_size = 12) +
theme(
legend.position = "top",
legend.box = "horizontal",
plot.title = element_text(face = "bold", size = 13),
panel.grid.major.x = element_line(color = "#ecf0f1", linewidth = 0.5)
) +
guides(color = guide_legend(order = 1), shape = guide_legend(order = 2))
# Save the plot
ggsave(file.path(PRIMARY_DIR, "Charity_Appearances_Dumbbell.pdf"), plot = p_dumbbell, width = 9, height = 7, device = "pdf")
